<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\PCEssentials.ico</ApplicationIcon>
    <AssemblyName>PCEssentials</AssemblyName>
    <RootNamespace>PCEssentials</RootNamespace>
    <Version>0.1.0</Version>
    <!-- WFO0003: WinForms (tray icon only) warns about the WPF manifest DPI setting, which is intentional.
         WPF0001: the Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon; keep its names out of the global scope. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\agent-prices.json" LogicalName="PCEssentials.Resources.agent-prices.json" />
    <!-- App logo: .exe icon via ApplicationIcon, and a WPF resource for the tray and window icons (pack URI). -->
    <Resource Include="Resources\PCEssentials.ico" />
  </ItemGroup>

</Project>
