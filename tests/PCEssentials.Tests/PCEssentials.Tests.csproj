<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The decision logic has no Win32 or WPF dependencies, so it is compiled in directly. That keeps the tests
       fast and avoids building the app into its bin folder, which is locked while PC Essentials runs. -->
  <ItemGroup>
    <Compile Include="..\..\src\PCEssentials\Services\GameMode\GameDetector.cs" Link="GameMode\GameDetector.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Screenshot\ShotGeometry.cs" Link="Screenshot\ShotGeometry.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Screenshot\ShotModel.cs" Link="Screenshot\ShotModel.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\AudioSessionKeys.cs" Link="Audio\AudioSessionKeys.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\ShakeToFind\ShakeDetector.cs" Link="ShakeToFind\ShakeDetector.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Agents\AgentLogPaths.cs" Link="Agents\AgentLogPaths.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Agents\AgentLogReader.cs" Link="Agents\AgentLogReader.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Agents\ClaudeAccounts.cs" Link="Agents\ClaudeAccounts.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Agents\AgentStats.cs" Link="Agents\AgentStats.cs" />
    <Compile Include="..\..\src\PCEssentials\Core\HotkeyMatcher.cs" Link="Core\HotkeyMatcher.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Launcher\FuzzyMatcher.cs" Link="Launcher\FuzzyMatcher.cs" />
    <Compile Include="..\..\src\PCEssentials\Services\Launcher\Calculator.cs" Link="Launcher\Calculator.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
